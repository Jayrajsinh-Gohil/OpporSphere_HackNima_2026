# ─────────────────────────────────────────────────────────────────────────────
#  opportunity-ecosystem-api — Environment Variables Example
#  Fill in your real values below.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="OpporSphere API"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-random-secret-key-here

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Gemini (Default LLM Provider) ────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# ── Ollama (Optional Local LLM) ──────────────────────────────────────────────
# Only needed if LLM_PROVIDER=ollama in the app_settings Supabase table
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma-4-31b-it

# ── LLM Provider (default fallback) ──────────────────────────────────────────
# This is the DEFAULT. Admins can override live via Supabase app_settings table.
# Values: "gemini" | "ollama"
LLM_PROVIDER=gemini

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
